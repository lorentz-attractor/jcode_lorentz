/target
Cargo.lock
__pycache__/
/.wrangler/
/tmp/
# Local onboarding sandbox + auth fixtures. May contain REAL OAuth tokens copied
# from $HOME (see scripts/onboarding_sandbox.sh seed-real-logins). Never commit.
/.tmp/
/.jcode/generated-images/
/telemetry-worker/backups/
target-ttest/
target-ttest*/

# Local capture artefacts are not committed baselines.
captures/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# assets/, docs/, and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png

# ---------------------------------------------------------------------------
# [jcode_lorentz] Arquivos sensiveis e pessoais. Nunca commitar.
# Secao propria do fork, mantida no fim do arquivo para evitar conflitos
# ao fazer merge do upstream.
# ---------------------------------------------------------------------------
# Credenciais e tokens do jcode (normalmente ficam em ~/.jcode, fora do repo)
auth.json
auth.bak
auth-refresh-state.json
auth-refresh-state.bak
*_oauth_usage.json
/config.toml
/config.toml.bak*

# Variaveis de ambiente e segredos
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
.secrets/

# Chaves e certificados
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Customizacoes locais que nao devem ir para o GitHub
/local/
*.local.toml
